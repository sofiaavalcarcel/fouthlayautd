APP_ENV=development

API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000

# Se pueden usar rutas absolutas o relativas a la raíz del proyecto.
DATABASE_PATH=storage/qa_automation.db
STORAGE_DIR=storage
PROGRAM_CATALOG_PATH=backend/data/Programas_UTEL_Todos_los_Paises.xlsx
LOG_LEVEL=INFO
# Filas por tanda y pausa entre tandas. No existe demora entre filas.
BATCH_SIZE=10
BATCH_DELAY_SECONDS=60
INCONCERT_INDEX_WAIT_SECONDS=60

# Se utilizarán en fases posteriores. Nunca incluir valores reales aquí.
STRAPI_URL=
STRAPI_TOKEN=
# Estado de Strapi que se consulta y actualiza: draft incluye productos no publicados.
STRAPI_CONTENT_STATUS=draft
STRAPI_CONTENT_DESCRIPTION_FIELD=contentDescription
STRAPI_SIU_KEY_FIELD=siuKey
STRAPI_BANNER_KEY_FIELD=bannerKey
# OAuth de Google Drive, solo lectura, para exportar Google Docs privados como DOCX.
# Autoriza el alcance https://www.googleapis.com/auth/drive.readonly.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
CRM_URL=
CRM_USERNAME=
CRM_PASSWORD=
INCONCERT_USERNAME=
INCONCERT_PASSWORD=

# Respaldo para localizar leads que todavía no aparecen en InConcert.
# Conserva los valores reales únicamente en tu archivo .env local.
LEAD_BALANCER_URL=https://lead-balancer.scalahed.com/leads/
LEAD_BALANCER_USERNAME=
LEAD_BALANCER_PASSWORD=

# Banco privado para envíos reales UTEL. Usa únicamente números activos de QA
# o de personas que hayan autorizado expresamente su uso. Se aceptan formatos
# E.164 (+código de país) o nacionales. Debe haber un número distinto por fila.
# Ejemplo de estructura (reemplaza los marcadores; no los envíes tal cual):
# UTEL_TEST_PHONES_JSON={"Mexico":["+52XXXXXXXXXX"],"Argentina":["+54XXXXXXXXXX"]}
UTEL_TEST_PHONES_JSON={}
# Solo para QA con formularios sintéticos: genera teléfonos con plan nacional
# válido sin usar números de terceros. Desactivado por seguridad.
UTEL_ALLOW_SYNTHETIC_REAL_PHONES=false

# IA: conserva los valores reales solo en .env, nunca aquí ni en el frontend.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=gpt-oss:120b
# Respaldo local: no usa la cuota de Ollama Cloud. Debes tener Ollama ejecutándose.
OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_LOCAL_MODEL=gpt-oss:20b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Weekly Performance. Crea una clave propia para PageSpeed Insights; nunca la
# escribas directamente en el código ni compartas el archivo .env.
PAGESPEED_API_KEY=
